# Скопируй в .env.deploy и заполни. Файл .env.deploy не коммитить.
# DEPLOY_HOST=root@IP_ИЛИ_ХОСТ_VDS
# DEPLOY_PATH=/home/atra/app/setki21_src
# Необязательно: имена продовых контейнеров
# SETKI21_API_CONTAINER_NAME=setki21-api-new
# SETKI21_WEB_CONTAINER_NAME=setki21-web-new
# Необязательно: общая docker-сеть на VDS (NPM, api, web, atra-postgres, atra-redis)
# SETKI21_SHARED_NETWORK=atra-network
# Необязательно: постоянная папка на VDS для логотипов и других uploads
# SETKI21_UPLOADS_PATH=/home/atra/setki21_uploads
# Необязательно: продовые подключения API. Если не заданы локально, deploy-скрипт попытается
# сохранить текущие значения из уже запущенного контейнера на VDS.
# DATABASE_URL=postgres://...
# REDIS_URL=redis://...
# POSTGRES_PASSWORD=...
# PORT=8080
#
# Публичный URL API для браузера (админка и калькулятор ходят с клиента по этому адресу).
# Если nginx проксирует /api на api:8080 — укажи базовый URL сайта, например:
# NUXT_PUBLIC_API_URL=https://www.setki21.ru
# Если API доступен по порту: NUXT_PUBLIC_API_URL=http://45.10.43.248:8083
# Не задан — скрипт деплоя подставит https://www.setki21.ru
