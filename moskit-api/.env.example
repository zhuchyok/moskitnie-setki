# Копируй в .env и подставь свои значения.
# PORT по умолчанию в коде 8081 — на VDS задать 8080 для NPM.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/moskit
# Порог баланса (₽): при балансе дилера ниже этого значения в stats возвращается алерт «низкий баланс» (кабинет и API).
LOW_BALANCE_THRESHOLD=5000
